# Copy to .env at the repo root. Both the API and the web app read this one
# file — apps/web/vite.config.ts sets envDir to the root for exactly that.

# ---------------------------------------------------------------- database
# Any PostgreSQL 14+ instance. Local install, no Docker needed.
DATABASE_URL=postgres://cue:cue@localhost:5432/cue

# --------------------------------------------------------------------- api
PORT=3002
# Origin the browser loads the web app from. Used for the CORS allow-list, so
# it must match exactly (scheme, host and port).
WEB_ORIGIN=http://localhost:5173
# Any long random string. Changing it signs everyone out.
JWT_SECRET=dev-secret-change-me

# ---------------------------------------------------------------- web push
# Generate a pair with:  npm run vapid
# The public key is not a secret — the browser needs it to subscribe.
# Changing either key invalidates every existing subscription, so generate once
# and keep the same pair across local and production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: or https: URL. Push services use it to contact you if your
# server starts misbehaving.
VAPID_SUBJECT=mailto:you@example.com

# ------------------------------------------------------- reminder engine
# How often the worker looks for due reminders.
REMINDER_POLL_MS=20000
# Gap between escalations once a reminder has fired and nothing was done.
ESCALATION_MINUTES=15
# How many times to chase before it stops buzzing. The commitment still stays
# in the "You dropped these" list forever — this only caps the notifications.
MAX_ESCALATIONS=4

# --------------------------------------------------------------------- web
# Port the Vite dev server binds to. Keep WEB_ORIGIN in sync with it.
WEB_PORT=5173

# Where the browser should call the API.
#   Development : http://localhost:3002  (Vite serves the app on another port)
#   Production  : leave BLANK — the API serves the built app from the same
#                 origin, so the browser just calls /api with no host at all.
VITE_API_URL=http://localhost:3002

# ------------------------------------------------- business lookup by location
# auto  = use Google when a key is set below, otherwise OpenStreetMap
# osm   = always OpenStreetMap (free, no key, patchy for small Indian clinics)
# google= always Google Places (much better coverage, needs billing enabled)
# none  = disable the "nearby businesses" suggestions entirely
PLACE_LOOKUP_PROVIDER=auto
# Leave blank to use the free OpenStreetMap provider.
GOOGLE_PLACES_API_KEY=

# ------------------------------------------------------- Google Calendar
# Lets someone connect their Google account and pick which calendars to mirror,
# instead of hunting for the "secret address in iCal format" — an option a
# Workspace administrator can switch off entirely.
#
# These are NOT billed API keys. Create an OAuth client at
# console.cloud.google.com -> APIs & Services -> Credentials, type "Web
# application". Enable the Google Calendar API for the project. No card needed.
#
# The authorised redirect URI must match EXACTLY. In production that is your
# own domain; in development it is this API's port, not the web port:
#   http://localhost:3002/api/oauth/google/callback
# Cue works that out from VITE_API_URL below, so normally you only register it
# with Google and leave GOOGLE_REDIRECT_URI blank.
#
# While the OAuth consent screen is in "Testing", only the accounts listed as
# test users can connect — add your own there or the sign-in is refused.
#
# ENCRYPTION_KEY below is required too: the tokens are stored encrypted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the derived one is wrong for your setup.
GOOGLE_REDIRECT_URI=

# ------------------------------------------------ Microsoft / Outlook calendar
# Same idea as Google, through Microsoft Graph. Also free, also not a billed key.
#
# Register at portal.azure.com -> Microsoft Entra ID -> App registrations ->
# New registration. Platform "Web", and add a client secret under
# "Certificates & secrets". The only permission needed is the delegated
# Microsoft Graph scope Calendars.Read.
#
# The redirect URI must match EXACTLY:
#   http://localhost:3002/api/oauth/microsoft/callback
#
# MICROSOFT_TENANT decides who may sign in:
#   common        work/school AND personal accounts (the default)
#   organizations work/school only
#   <tenant id>   one organisation only
# A personal planner is a personal thing even when the calendar is not, so the
# default is the permissive one.
#
# ENCRYPTION_KEY below is required too: the tokens are stored encrypted.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Only if the derived one is wrong for your setup.
MICROSOFT_REDIRECT_URI=

# ------------------------------------------- understanding dictated sentences
# Encrypts stored credentials at rest — AI provider keys and Google tokens.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every stored key unreadable and they must be re-entered.
ENCRYPTION_KEY=
# Model used when an org chooses the 'anthropic' provider and supplies a key.
AI_DEFAULT_MODEL=claude-haiku-4-5-20251001

# ------------------------------------------------------------------- travel
# Average door-to-door speed used for travel-time estimates. Indian roads
# rather than motorways; raise it if your journeys are mostly highway.
TRAVEL_SPEED_KMH=45
